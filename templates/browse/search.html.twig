{% extends 'base.html.twig' %}

{% block title %}
  {{ parent() }} - Suche
{% endblock %}

{% block body %}
  <form id="catalogueSearch" action="{{ path('PapyrillioHgvBundle_Home') }}" method="get" autocomplete="off">
    <div class="search">
      <h5>
        Filter für die Tabellenansicht
        <a href="{{ path('PapyrillioHgvBundle_DefaultHelp', {'topic': 'search', language: 'en'}) }}" title="Search Help in English"> → Search Help</a>
        <a href="{{ path('PapyrillioHgvBundle_DefaultHelp', {'topic': 'search', language: 'de'}) }}" title="Suchhilfe auf Deutsch"> → Suchhilfe</a>
      </h5>

      {% if matomo.searchKeywords|length > 0 %}
      <p>Häufig gesucht:
        {% for keyword, hits in matomo.searchKeywords %}
          {% if loop.index < 30 and not(keyword matches '/\\d/') %}
            <span>{{ keyword }}{{ loop.index < 29 ? ' · ' : '' }}</span>
          {% endif %}
        {% endfor %}
      </p>
      {% endif %}

      <p><button type="button" id="filterSyntaxBtn" class="btn-filter-help">Filtersyntax anzeigen</button></p>

      <div class="searchFields">
        <fieldset class="searchId">
          <legend>Identifikation</legend>
          <div><label for="f_publ">Publikation</label>
            <input type="text" name="filter[publ]" id="f_publ" /></div>
          <div><label for="f_pubVol">Band</label>
            <input type="text" name="filter[pubVol]" id="f_pubVol" /></div>
          <div><label for="f_pubNr">Nummer</label>
            <input type="text" name="filter[pubNr]" id="f_pubNr" /></div>
          <div><label for="f_tm">TM Nr.</label>
            <input type="text" name="filter[tm]" id="f_tm" /></div>
          <div><label for="f_hgvId">HGV Id</label>
            <input type="text" name="filter[hgvId]" id="f_hgvId" /></div>
          <div><label for="f_ddb">DDB</label>
            <input type="text" name="filter[ddb]" id="f_ddb" /></div>
        </fieldset>

        <fieldset class="searchDescription">
          <legend>Inhalt</legend>
          <div><label for="f_title">Titel</label>
            <input type="text" name="filter[title]" id="f_title" /></div>
          <div><label for="f_keywords">Schlagworte</label>
            <input type="text" name="filter[keywords]" id="f_keywords" /></div>
          <div><label for="f_material">Material</label>
            <input type="text" name="filter[material]" id="f_material" /></div>
          <div><label for="f_commentary">Bemerkungen</label>
            <input type="text" name="filter[commentary]" id="f_commentary" /></div>
        </fieldset>

        <fieldset class="searchDate">
          <legend>Datierung</legend>
          <div><label for="f_dating">Datierung</label>
            <input type="text" name="filter[dating]" id="f_dating" /></div>
          <div><label for="f_notBefore">Nicht vor</label>
            <input type="text" name="filter[notBefore]" id="f_notBefore" /></div>
          <div><label for="f_notAfter">Nicht nach</label>
            <input type="text" name="filter[notAfter]" id="f_notAfter" /></div>
          <div><label for="f_when">Genaudatum</label>
            <input type="text" name="filter[when]" id="f_when" /></div>
        </fieldset>

        <fieldset class="searchImage">
          <legend>Herkunft &amp; Aufbewahrung</legend>
          <div><label for="f_place">Ort</label>
            <input type="text" name="filter[place]" id="f_place" /></div>
          <div><label for="f_provenance">Herkunft</label>
            <input type="text" name="filter[provenance]" id="f_provenance" /></div>
          <div><label for="f_settlement">Aufbewahrungsort</label>
            <input type="text" name="filter[settlement]" id="f_settlement" /></div>
          <div><label for="f_collection">Sammlung</label>
            <input type="text" name="filter[collection]" id="f_collection" /></div>
          <div><label for="f_invNo">Inv.-Nr.</label>
            <input type="text" name="filter[invNo]" id="f_invNo" /></div>
        </fieldset>

        <fieldset class="searchOptions">
          <legend>Referenzen</legend>
          <div><label for="f_otherPub">Andere Publikationen</label>
            <input type="text" name="filter[otherPub]" id="f_otherPub" /></div>
          <div><label for="f_illustrations">Abbildungen</label>
            <input type="text" name="filter[illustrations]" id="f_illustrations" /></div>
          <div><label for="f_figureUrls">Bild-URLs</label>
            <input type="text" name="filter[figureUrls]" id="f_figureUrls" /></div>
          <div><label for="f_translations">Übersetzungen</label>
            <input type="text" name="filter[translations]" id="f_translations" /></div>
          <div><label for="f_mentionedDatesCol">Erwähnte Daten (Text)</label>
            <input type="text" name="filter[mentionedDates]" id="f_mentionedDatesCol" /></div>
          <div><label for="f_blOnline">BL online</label>
            <input type="text" name="filter[blOnline]" id="f_blOnline" /></div>
        </fieldset>
      </div>
    </div>

    <div class="additionalSearchOptions">
      <h5>Optionen</h5>

      <fieldset class="searchOptions">
        <legend>Erwähnte Daten einbeziehen</legend>
        <label><input type="radio" name="search[mentionedDates]" value="without" checked="checked" /> Nur in <b>Hauptdatenbank</b> suchen</label><br />
        <label><input type="radio" name="search[mentionedDates]" value="with" /> Bei Suche <b>erwähnte Daten</b> mit einbeziehen</label><br />
        <label><input type="radio" name="search[mentionedDates]" value="only" /> Nur in <b>erwähnten Daten</b> suchen</label>
      </fieldset>

      <fieldset>
        <legend>Initiale Sortierung</legend>
        {% for i in 1..3 %}

          <label for="sortKey_{{ i }}">{{ i }}. Stufe</label>
          <select name="sort[{{ i }}][key]" id="sortKey_{{ i }}" style="width: 180px">
            <option value="">{{ i == 1 ? '— Standard (Datum) —' : '—' }}</option>
            <option value="publ">Publikation</option>
            <option value="dating">Datierung</option>
            <option value="place">Ort</option>
            <option value="title">Titel</option>
            <option value="material">Material</option>
            <option value="keywords">Schlagworte</option>
            <option value="otherPub">Andere Publikationen</option>
            <option value="tm">TM Nr.</option>
            <option value="ddb">DDB</option>
            <option value="hgvId">HGV Id</option>
            <option value="notBefore">Nicht vor</option>
            <option value="notAfter">Nicht nach</option>
            <option value="settlement">Aufbewahrungsort</option>
            <option value="collection">Sammlung</option>
            <option value="invNo">Inv.-Nr.</option>
            <option value="provenance">Herkunft</option>
            <option value="illustrations">Abbildungen</option>
            <option value="translations">Übersetzungen</option>
            <option value="commentary">Bemerkungen</option>
            <option value="blOnline">BL online</option>
          </select>
          <select name="sort[{{ i }}][dir]" id="sortDir_{{ i }}">
            <option value="asc">aufsteigend</option>
            <option value="desc">absteigend</option>
          </select>
          <br />
        {% endfor %}
      </fieldset>
      <fieldset>
        <legend>Anzeige</legend>
        <label for="pageLen">Einträge pro Seite</label>
        <select name="pageLength" id="pageLen">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50" selected="selected">50</option>
          <option value="100">100</option>
          <option value="200">200</option>
          <option value="500">500</option>
        </select>
      </fieldset>
    </div>

      <p>
        <input type="submit" value="Tabelle öffnen" />
        <input type="reset" value="Felder löschen" />
      </p>

  </form>

  {# ── Filter syntax modal (reuses dt-tips styles) ── #}
  <div id="dt-tips-overlay" class="dt-tips-hidden">
    <div id="dt-tips-modal">
      <button id="dt-tips-close" title="Schließen">&times;</button>
      <h3>Filtersyntax</h3>
      <p>Gilt für alle Eingabefelder auf dieser Seite und für die Spaltenfilter in der Tabellenansicht.</p>
      <table class="dt-tips-table">
        <tr><th>Eingabe</th><th>Bedeutung</th><th>Beispiel</th></tr>
        <tr><td><code>text</code></td><td>Enthält (Standard)</td><td><code>Oxy</code></td></tr>
        <tr><td><code>wort1 wort2</code></td><td>Alle Wörter müssen vorkommen</td><td><code>Brief privat</code></td></tr>
        <tr><td><code>^text</code></td><td>Beginnt mit</td><td><code>^P.Oxy</code></td></tr>
        <tr><td><code>text$</code></td><td>Endet mit</td><td><code>Verso$</code></td></tr>
        <tr><td><code>=text</code></td><td>Exakter Treffer</td><td><code>=Papyrus</code></td></tr>
        <tr><td><code>!text</code></td><td>Enthält nicht / ungleich</td><td><code>!Papyrus</code></td></tr>
        <tr><td><code>&gt;n</code> <code>&lt;n</code> <code>&gt;=n</code> <code>&lt;=n</code></td><td>Numerischer Vergleich</td><td><code>&gt;100</code></td></tr>
        <tr><td><code>n...m</code></td><td>Datumsbereich (auch negativ)</td><td><code>-300...-100</code></td></tr>
        <tr><td><code>*</code></td><td>Feld nicht leer</td><td><code>*</code></td></tr>
        <tr><td><code>=</code></td><td>Feld leer</td><td><code>=</code></td></tr>
      </table>
      <h4>Sortierung</h4>
      <p>Klick auf eine Spaltenüberschrift sortiert nach dieser Spalte.<br />
      <kbd>Shift</kbd> + Klick fügt eine weitere Sortierstufe hinzu (mehrstufige Sortierung).</p>
      <h4>Spalten</h4>
      <p>Spalten können per Drag &amp; Drop auf den Spaltenüberschriften verschoben werden.<br />
      Über den Button <em>Spalten</em> lassen sich weitere Spalten ein- und ausblenden.</p>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
  $(function() {
    $('#filterSyntaxBtn').on('click', function() {
      $('#dt-tips-overlay').removeClass('dt-tips-hidden');
    });
    $('#dt-tips-close, #dt-tips-overlay').on('click', function(ev) {
      if (ev.target === this) $('#dt-tips-overlay').addClass('dt-tips-hidden');
    });
  });
  </script>
{% endblock %}
