{# Testfälle: 1005, 28210, 44502, 50307, 8886, 19648, 63705, 9088, 8981a #}

<h3 class="catalogueShow">
  {% if record.publicationFull %}
    <a  href="#{{ record.id }}" onclick="top.location.href = '{{ path('PapyrillioHgvBundle_ShortcutHgv', {'id': record.hgvId}) }}'">{{ record.publicationFull|raw }}</a>
  {% else %}
     …
  {% endif %}
  {% if record.tm %}
    <a  href="http://www.trismegistos.org/tm/detail.php?quick={{ record.tm }}" target="DAHT">TM Nr. {{ record.tm }}</a>
    {% if record.tm~'' != record.id %}
      <span class="mini">(HGV Nr. {{ record.id }})</span>
    {% endif %}
  {% endif %}
</h3>

<h4 class="catalogueShow">
  {% if record.title == 'keiner' %}
      {{ 'datasheet.title_label'|trans }}
  {% endif %}
  {{ record.title|raw }}
</h4>

<h5 class="catalogueShow">
  {% if record.place %}
    {% if record.place == 'unbekannt' %}
      {{ 'datasheet.place_label'|trans }}
    {% endif %}
    <span>{{ record.place|raw }}</span>
  {% endif %}
  {% if record.dates|length > 1 %}
    {% for d in record.dates %}
      <span class="Datierung">{{ d.dating|raw }}</span>
      {% if not loop.last %}<br />{% endif %}
    {% endfor %}
  {% elseif record.dating %}
    <span class="Datierung">{{ record.dating|raw }}</span>
  {% endif %}
</h5>

<table class="catalogueShow">
  <tbody>
    {% if record.otherPublications %}
      <tr>
        <th>{{ 'datasheet.other_publications'|trans }}</th>
        <td>{{ record.otherPublications|raw }}</td>
      </tr>
    {% endif %}
    {% if record.material %}
      <tr>
        <th>{{ 'datasheet.material'|trans }}</th>
        <td>{{ record.material|raw }}</td>
      </tr>
    {% endif %}
    {% if record.illustrations %}
      <tr class="pictureLinks">
        <th>{{ 'datasheet.illustration'|trans }}</th>
        <td>
          {{ record.illustrations|raw }}
        </td>
      </tr>
    {% endif %}
    {% if record.bl or record.blOnline %}
      <tr>
        <th>{{ 'datasheet.bl_entries'|trans }} <br /> <span class="mini">{{ 'datasheet.bl_concordance'|trans }}</span></th>
        <td>
          {{ record.bl|raw }}
          {% if record.blOnline %}
            <a target="Neu" href="https://beehive.zaw.uni-heidelberg.de/hgv/{{ record.hgvId }}">{{ 'datasheet.bl_online'|trans }}</a>
          {% endif %}
        </td>
      </tr>
    {% endif %}
    {% if record.commentary %}
      <tr>
        <th>{{ 'datasheet.commentary'|trans }}</th>
        <td>{{ record.commentary|raw }}</td>
      </tr>
    {% endif %}
    {% if record.translations %}
      <tr class="translation">
        <th>{{ 'datasheet.translations'|trans }}<br/><span class="hide">{{ 'datasheet.translations_hide'|trans }}</span><span class="show">{{ 'datasheet.translations_show'|trans }}</span></th>
        <td>
          {% set translations = processTranslations(record.translations) %}
          {% if translations %}
            {% for language, translation in translations %}
              <b>{{ language }}:</b>
              <br />
              <ul>
              {% for bibliography in translation %}
                <li>{{ bibliography|raw }}</li>
              {% endfor %}
              </ul>
            {% endfor %}
          {% else %}
            {{ record.translations|raw }}
          {% endif %}
        </td>
      </tr>
    {% endif %}
    {% if record.keywords %}
      {% set kwTrans = record.keywordTranslations %}
      <tr class="{{ kwTrans|length ? 'keywordsHidden' : '' }}">
        <th>
          {{ 'datasheet.content'|trans }}
          {% if kwTrans|length %}
            <br/>
            <span class="show">{{ 'datasheet.content_show_translations'|trans }}</span>
            <span class="hide">{{ 'datasheet.content_hide_translations'|trans }}</span>
          {% endif %}
        </th>
        <td>
          {{ record.keywords|raw }}
          {% if kwTrans|length %}
            <ul class="keywordsTranslations">
              {% for lang, joined in kwTrans %}
                <li><b>{{ lang }}:</b> {{ joined }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </td>
      </tr>
    {% endif %}
    {% if record.provenances|length %}
      <tr>
        <th>{{ 'datasheet.provenance'|trans }}</th>
        <td>
          <ul>
            {% for prov in record.provenances %}
              <li>
                {% if prov.type %}<em>{{ prov.type }}</em>: {% endif %}
                {% if prov.placeRef and 'trismegistos.org/' in prov.placeRef %}
                  <a href="{{ prov.placeRef starts with 'http' ? prov.placeRef : 'https://' ~ prov.placeRef }}" target="_blank">{{ prov.place }}</a>
                {% else %}
                  {{ prov.place }}
                {% endif %}
                {% if prov.nome %}
                  –
                  {% if prov.nomeRef and 'trismegistos.org/' in prov.nomeRef %}
                    <a href="{{ prov.nomeRef starts with 'http' ? prov.nomeRef : 'https://' ~ prov.nomeRef }}" target="_blank">{{ prov.nome }}</a>
                  {% else %}
                    {{ prov.nome }}
                  {% endif %}
                {% endif %}
                {% if prov.region %}
                  ({% if prov.regionRef and 'trismegistos.org/' in prov.regionRef %}
                    <a href="{{ prov.regionRef starts with 'http' ? prov.regionRef : 'https://' ~ prov.regionRef }}" target="_blank">{{ prov.region }}</a>
                  {% else %}
                    {{ prov.region }}
                  {% endif %})
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </td>
      </tr>
    {% endif %}
    {% if record.mentionedDatesText %}
      <tr class="mentionedDates">
        <th>{{ 'datasheet.mentioned_dates'|trans }}</th>
        <td>
          {% if record.mentionedDates and record.mentionedDates|length %}
            <ul>
              {% for mentionedDate in record.mentionedDates %}
                <li>
                  {% if mentionedDate.zeile %}
                    <b>{{ mentionedDate.zeile }}:</b>
                  {% endif %}
                  {{ mentionedDate.datierung }}
                </li>
              {% endfor %}
            </ul>
          {% else %}
            {{ record.mentionedDatesText|raw }}
          {% endif %}
        </td>
      </tr>
    {% endif %}
  </tbody>
</table>

<div class="dashboard">
  <div class="text">
    {% if record.hasHtmlDdb %}
      <h6>
        {{ 'datasheet.ddb_texts'|trans }}
        {% if record.ddbSer %}
          <a target="Text" href="http://papyri.info/ddbdp/{{ record.ddbSer }};{{ record.ddbVol }};{{ record.ddbDoc }}">papyri.info</a>
        {% endif %}
        <span class="show">{{ 'datasheet.ddb_show_info'|trans }}</span>
        <button class="clipboard" data-clipboard-target="#ddbText" title="Firefox 41+, Safari 10+, Chrome42+, Opera 29+, IE 9+, Edge12+">{{ 'datasheet.ddb_copy'|trans }}</button>
      </h6>    
      <div id="ddbText">
        {{ record.htmlDdb|raw }}
      </div>
      {% if record.ddbSer %}
        <a target="Text" href="http://papyri.info/ddbdp/{{ record.ddbSer }};{{ record.ddbVol }};{{ record.ddbDoc }}">papyri.info</a>
      {% endif %}
    {% else %}
      {{ 'datasheet.no_ddb_text'|trans }}
    {% endif %}
  </div>
  
  <div class="pictureLink">
    <h6>{{ 'datasheet.digital_info'|trans }} <span class="hide">{{ 'datasheet.hide'|trans }}</span></h6>
    {% if record.pictureLinks|length %}
      {% for pictureLink in record.pictureLinks %}
          {% if pictureLink.url|slice(-3) == 'jpg' %}
            <img src="{{ pictureLink.url|raw }}" class="pictureLink" title="{{pictureLink.institution}}" alt="{{ 'datasheet.internet_image'|trans }} ({{pictureLink.institution}})" />
          {% else %}
            <div class="pictureLinkWrapper">
              <iframe class="pictureLinkFrame" src="{{ pictureLink.url|raw }}"> </iframe>
            </div>
          {% endif %}
          <br class="clear" />
          <a target="Neu" href="{{ pictureLink.url|raw }}" title="{{ pictureLink.url }}">→ {{ pictureLink.institution }}</a>
      {% endfor %}
    {% else %}
      {{ 'datasheet.no_images'|trans }}
    {% endif %}
  </div>
  
  <div class="translation">
    <h6>{{ 'datasheet.hgv_translations'|trans }}</h6>
    {% if record.htmlTranslation %}
      {{ record.htmlTranslation|raw }}
    {% else %}
      {{ 'datasheet.no_translations'|trans }}
    {% endif %}
  </div>

</div>
<br class="clear"/>


