{% extends 'base.html.twig' %}

{% block title %}
  {{ record ? record.publicationFull|raw ~ ' (TM/HGV ' ~ record.id ~ ')' ~ ' - ' ~ record.title|raw : parent() }}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
{% endblock %}

{% block body %}

  <p>{{ 'single.record_of'|trans({'%current%': (record ? (show ? show['skip'] + 1 : 1) : 0), '%total%': countSearch, '%count%': countTotal}) }}

    {% if showPrev %}
      <a href="{{ path('PapyrillioHgvBundle_BrowseSingle', {'search': search, 'sort': sort, 'show': showPrev}) }}">{{ 'single.back'|trans }}</a>
    {% endif %}

    {% if showNext %}
      <a href="{{ path('PapyrillioHgvBundle_BrowseSingle', {'search': search, 'sort': sort, 'show': showNext}) }}">{{ 'single.forward'|trans }}</a>
    {% endif %}

  </p>

  {# Testfälle: 50307, 8886, 19648, 63705, 9088, 8981a #}

  {% if record %}
    {% include 'browse/_datasheet.html.twig' with { 'record': record } %}
  {% endif %}

  {% if showPrev %}
    <a href="{{ path('PapyrillioHgvBundle_BrowseSingle', {'search': search, 'sort': sort, 'show': showPrev}) }}">{{ 'single.back'|trans }}</a>
  {% endif %}

  {% if showNext %}
    <a href="{{ path('PapyrillioHgvBundle_BrowseSingle', {'search': search, 'sort': sort, 'show': showNext}) }}">{{ 'single.forward'|trans }}</a>
  {% endif %}

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('js/datasheet.js') }}" type="text/javascript"></script>
{% endblock %}
