{% extends 'base.html.twig' %}

{% block title %}
  {{ parent() }} - Tabelle
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('js/DataTables/datatables.min.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block body %}

  <table id="catalogueTable" class="catalogueList display"
         data-api-url="{{ path('PapyrillioHgvBundle_BrowseMultipleApi') }}"
         data-single-url="{{ path('PapyrillioHgvBundle_BrowseSingle') }}">
    <thead>
      <tr>
        <th>#</th>
        <th>Publikation</th>
        <th>Datierung</th>
        <th>Ort</th>
        <th>Titel</th>
        <th>Material</th>
        <th>Inhalt / Schlagworte</th>
        <th>Andere Publikationen</th>
        <th>TM Nr.</th>
      </tr>
    </thead>
    <tfoot>
      <tr>
        <th></th>
        <th>Publikation</th>
        <th>Datierung</th>
        <th>Ort</th>
        <th>Titel</th>
        <th>Material</th>
        <th>Inhalt / Schlagworte</th>
        <th>Andere Publikationen</th>
        <th>TM Nr.</th>
      </tr>
    </tfoot>
  </table>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('js/DataTables/datatables.min.js') }}" type="text/javascript"></script>
  <script src="{{ asset('js/browseMulti.js') }}" type="text/javascript"></script>
{% endblock %}
