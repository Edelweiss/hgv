{% extends 'base.html.twig' %}

{% block title %}
  {{ parent() }} - {{ 'table.page_title'|trans }}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('js/DataTables/datatables.min.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block body %}

  <table id="catalogueTable" class="catalogueList display"
         data-root-url="{{ path('PapyrillioHgvBundle_Home') }}"
         data-api-url="{{ path('PapyrillioHgvBundle_BrowseMultipleApi') }}"
         data-single-url="{{ path('PapyrillioHgvBundle_BrowseSingle') }}">
    <thead>
      <tr>
        <th>{{ 'table.row_number'|trans }}</th>
        <th>{{ 'table.publication'|trans }}</th>
        <th>{{ 'table.dating'|trans }}</th>
        <th>{{ 'table.place'|trans }}</th>
        <th>{{ 'table.title'|trans }}</th>
        <th>{{ 'table.material'|trans }}</th>
        <th>{{ 'table.keywords'|trans }}</th>
        <th>{{ 'table.other_publications'|trans }}</th>
        <th>{{ 'table.tm_no'|trans }}</th>
        <th>{{ 'table.ddb'|trans }}</th>
        <th>{{ 'table.hgv_id'|trans }}</th>
        <th>{{ 'table.publication_abbr'|trans }}</th>
        <th>{{ 'table.volume'|trans }}</th>
        <th>{{ 'table.number'|trans }}</th>
        <th>{{ 'table.not_before'|trans }}</th>
        <th>{{ 'table.not_after'|trans }}</th>
        <th>{{ 'table.exact_date'|trans }}</th>
        <th>{{ 'table.precision'|trans }}</th>
        <th>{{ 'table.settlement'|trans }}</th>
        <th>{{ 'table.collection'|trans }}</th>
        <th>{{ 'table.inv_no'|trans }}</th>
        <th>{{ 'table.provenance'|trans }}</th>
        <th>{{ 'table.provenance_place'|trans }}</th>
        <th>{{ 'table.provenance_nome'|trans }}</th>
        <th>{{ 'table.illustrations'|trans }}</th>
        <th>{{ 'table.figure_urls'|trans }}</th>
        <th>{{ 'table.translations'|trans }}</th>
        <th>{{ 'table.commentary'|trans }}</th>
        <th>{{ 'table.mentioned_dates'|trans }}</th>
        <th>{{ 'table.bl_online'|trans }}</th>
      </tr>
    </thead>
    <tfoot>
      <tr>
        <th></th>
        <th>{{ 'table.publication'|trans }}</th>
        <th>{{ 'table.dating'|trans }}</th>
        <th>{{ 'table.place'|trans }}</th>
        <th>{{ 'table.title'|trans }}</th>
        <th>{{ 'table.material'|trans }}</th>
        <th>{{ 'table.keywords'|trans }}</th>
        <th>{{ 'table.other_publications'|trans }}</th>
        <th>{{ 'table.tm_no'|trans }}</th>
        <th>{{ 'table.ddb'|trans }}</th>
        <th>{{ 'table.hgv_id'|trans }}</th>
        <th>{{ 'table.publication_abbr'|trans }}</th>
        <th>{{ 'table.volume'|trans }}</th>
        <th>{{ 'table.number'|trans }}</th>
        <th>{{ 'table.not_before'|trans }}</th>
        <th>{{ 'table.not_after'|trans }}</th>
        <th>{{ 'table.exact_date'|trans }}</th>
        <th>{{ 'table.precision'|trans }}</th>
        <th>{{ 'table.settlement'|trans }}</th>
        <th>{{ 'table.collection'|trans }}</th>
        <th>{{ 'table.inv_no'|trans }}</th>
        <th>{{ 'table.provenance'|trans }}</th>
        <th>{{ 'table.provenance_place'|trans }}</th>
        <th>{{ 'table.provenance_nome'|trans }}</th>
        <th>{{ 'table.illustrations'|trans }}</th>
        <th>{{ 'table.figure_urls'|trans }}</th>
        <th>{{ 'table.translations'|trans }}</th>
        <th>{{ 'table.commentary'|trans }}</th>
        <th>{{ 'table.mentioned_dates'|trans }}</th>
        <th>{{ 'table.bl_online'|trans }}</th>
      </tr>
    </tfoot>
  </table>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('js/DataTables/datatables.min.js') }}" type="text/javascript"></script>
  <script src="{{ asset('js/browseMulti.js') }}" type="text/javascript"></script>
{% endblock %}
