{% extends 'base.html.twig' %}

{% block title %}{{ 'site.title'|trans }} – {{ parent() }}{% endblock %}

{% block body %}

 <div class="page index"> 
 
  <h5 style="text-align: center; font-size: 2em;"><font style="color: #ff0000; font-size: 1.4em;">H</font>EIDELBERGER <font style="color: #ff0000; font-size: 1.4em;">G</font>ESAMTVERZEICHNIS<br /> DER GRIECHISCHEN <font style="color: #ff0000; font-size: 1.4em;">P</font>APYRUSURKUNDEN <font style="color: #ff0000; font-size: 1.4em;">Ä</font>GYPTENS</h5>
  <p style="text-align: center; font-size: 1em; font-weight: bold;">{{ 'site.subtitle'|trans }}</p>
  <p style="text-align: center;"><img src="{{ asset('images/Siegel1.png') }}" width="200px"/><img src="{{ asset('images/Siegel2c.png') }}" width="200px"/></p>

  <hr /> 
  
  <p>
    {{ 'home.welcome'|trans }} <a href="{{ path('PapyrillioHgvBundle_DefaultIntroduction') }}">{{ 'home.introduction_link'|trans }}</a> {{ 'home.and_the'|trans }} <a href="{{ path('PapyrillioHgvBundle_DefaultHelp', {'topic': 'search'}) }}" title="{{ 'nav.help_de_title'|trans }}">{{ 'search.search_help'|trans }}</a> {{ 'home.read_notes'|trans }}
  </p>
  
  <p>
    {{ 'home.direct_search'|trans }} "<a href="{{ path('PapyrillioHgvBundle_Home') }}">{{ 'home.main_register'|trans }}</a>".<br /> 
    {{ 'home.text_info'|trans }} <a href="{{ path('PapyrillioHgvBundle_PublicationIndex') }}">{{ 'home.texts_in_hgv'|trans }}</a>.
  </p>

  <p><b>{{ 'home.links_to'|trans }}</b></p>
  <ul style="list-style-type: none; padding-left: 0;">
    <li style="margin-left: 2em;"><a href="https://papy.zaw.uni-heidelberg.de/gv0/">{{ 'home.published_pieces'|trans }}</a> {{ 'home.published_pieces_desc'|trans }}</li>
    <li style="margin-left: 2em;"><a href="https://www.ub.uni-heidelberg.de/papyri">{{ 'home.catalogs'|trans }}</a> {{ 'home.catalogs_desc'|trans }}</li>
    <li style="margin-left: 2em;"><a href="https://papyri.uni-koeln.de/papyri-woerterlisten/index.html">{{ 'home.word_lists'|trans }}</a> {{ 'home.word_lists_desc'|trans }}</li>
  </ul>
 
 </div>

{% endblock %}
