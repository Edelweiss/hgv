<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        {% include 'matomo_tag.html' %}
        <meta charset="UTF-8" />
        <title>{% block title %}HGV{% endblock %}</title>
        {% block stylesheets %}
          <link href="{{ asset('css/960/reset.css') }}" type="text/css" rel="stylesheet" />
          <link href="{{ asset('css/960/text.css') }}" type="text/css" rel="stylesheet" />
          <link href="{{ asset('css/960/960.css') }}" type="text/css" rel="stylesheet" />
          <link href="{{ asset('css/main.css?1') }}" type="text/css" rel="stylesheet" />
          <link href="{{ asset('css/print.css') }}" type="text/css" rel="stylesheet" media="print" />
        {% endblock %}
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
        {% include 'matomo.html' %}
    </head>
    <body>
    {% if app.environment == 'dev' %}
      <img src="{{ asset('images/dev.png') }}" alt="bleeding edge" width="100" style="position: fixed; right: 0; z-index: 999;" />
    {% endif %}
    <div id="wrapper"><!-- #wrapper -->
      <header><!-- header -->
        <h1><a href="#">{{ 'site.title'|trans }}</a></h1>
        
        <h2 style="position: relative;">
        <a href="{{ path('PapyrillioHgvBundle_DefaultIndex') }}"><img id="hgv" src="{{ asset('images/HGV.png') }}" alt="{{ 'header.hgv_alt'|trans }}" title="{{ 'site.title'|trans }}" /></a>  
            <a href="{{ path('PapyrillioHgvBundle_DefaultIndex') }}"><img id="logo" src="{{ asset('images/Siegel2c.png') }}" alt="{{ 'header.seal_alt'|trans }}" title="{{ 'header.academy_seal_title'|trans }}" /></a>
            <a href="{{ path('PapyrillioHgvBundle_DefaultIndex') }}"><img id="logo" src="{{ asset('images/Siegel1.png') }}" alt="{{ 'header.seal_alt'|trans }}" title="{{ 'header.uni_seal_title'|trans }}" /></a>
        </h2>
      </header><!-- end of header -->

      <nav><!-- top nav -->
        <div class="menu">
          <ul>
            <li><a href="{{ path('PapyrillioHgvBundle_Home') }}" title="{{ 'nav.table_title'|trans }}">{{ 'nav.table'|trans }}</a></li>
            <li><a href="{{ path('PapyrillioHgvBundle_BrowseSearch') }}" title="{{ 'nav.search_title'|trans }}">{{ 'nav.search'|trans }}</a></li>
            <li><a href="{{ path('PapyrillioHgvBundle_PublicationIndex') }}" title="{{ 'nav.publications_title'|trans }}">{{ 'nav.publications'|trans }}</a></li>
            <li><a href="{{ path('PapyrillioHgvBundle_DigitalAssistant') }}" title="{{ 'nav.digital_assistant_title'|trans }}">{{ 'nav.digital_assistant'|trans }}</a></li>
            <li class="inactive">
              <a href="{{ path('PapyrillioHgvBundle_DefaultIndex') }}" title="{{ 'nav.info'|trans }}">{{ 'nav.info'|trans }}</a>
              <ul class="sub">
                <li><a href="{{ path('PapyrillioHgvBundle_DefaultIntroduction') }}" title="{{ 'nav.introduction_title'|trans }}">{{ 'nav.introduction'|trans }}</a></li>
                <li><a href="{{ path('PapyrillioHgvBundle_DefaultAbbreviation') }}" title="{{ 'nav.abbreviations_title'|trans }}">{{ 'nav.abbreviations'|trans }}</a></li>
            <li><a href="https://papy.zaw.uni-heidelberg.de/gv0" title="{{ 'nav.published_pieces_title'|trans }}">{{ 'nav.published_pieces'|trans }}</a></li>
                <li>
                  <a href="#" id="feedbackLink" title="{{ 'nav.feedback_title'|trans }}">{{ 'nav.feedback'|trans }}</a>
                  <div id="feedbackDialogue" style="display: none;" title="{{ 'feedback.dialogue_title'|trans }}">
                    <div class="ui-widget">
                      <div id="feedbackInfo" class="ui-state-highlight ui-corner-all">
                        <p>
                          <span class="ui-icon ui-icon-info"></span>
                          <strong>Hey!</strong> <span></span>
                        </p>
                      </div>
                    </div>
                    <form id="feedback" action="#">
                      <label for="feedbackName">{{ 'feedback.name'|trans }}</label>
                      <input type="text" id="feedbackName" name="name" tabindex="1001" required />
                      <br/>
                      <label for="feedbackEmailAddress">{{ 'feedback.email'|trans }}</label>
                      <input type="email" id="feedbackEmailAddress" name="email" tabindex="1002" required />
                      <br/>
                      <label for="feedbackSubject">{{ 'feedback.subject'|trans }}</label>
                      <input type="text" id="feedbackSubject" name="subject" value="" tabindex="1003" />
                      <br/>
                      <textarea id="feedbackMessage" name="message" rows="4" tabindex="1004" required ></textarea>
                      <br/>
                      <button type="submit" tabindex="1006" id="feedbackSend">{{ 'feedback.send'|trans }}</button>
                      <button type="reset" tabindex="1007" id="feedbackCancel">{{ 'feedback.reset'|trans }}</button>
                      <br/>
                    </form>
                    <p>
                      {{ 'feedback.instruction'|trans }} <a id="feedbackEmail" href="mailto:james.cowey@urz.uni-heidelberg.de,carmen.lanz@uni-heidelberg.de?subject={{ 'js.feedback.default_subject'|trans|url_encode }}&body={{ 'js.feedback.default_body'|trans|url_encode }}">E-Mail</a>.
                    </p>
                  </div>
                </li>
              </ul>
            </li>

          </ul>
          <div class="language-switcher">
            {% for locale in ['de', 'en'] %}
              {% if app.request.locale == locale %}
                <span class="active"><img src="{{ asset('images/lang_' ~ locale ~ '.png') }}" alt="{{ ('language.' ~ locale)|trans }}" /></span>
              {% else %}
                <a href="{{ path('app_switch_locale', {locale: locale}) }}"><img src="{{ asset('images/lang_' ~ locale ~ '.png') }}" alt="{{ ('language.' ~ locale)|trans }}" /></a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </nav><!-- end of top nav -->

      <section id="main">
        <section id="content"><!-- #content -->
          {% block body %}{% endblock %}
        </section><!-- end of #content -->
      </section><!-- end of #main content and sidebar-->
      
      <footer>
      <section id="footer-area">
  
        <section id="footer-outer-block">
            <aside class="footer-segment">
                <h4>{{ 'footer.catalogs'|trans }}</h4>
                <ul>
                  <li><a target="_blank" href="https://www.ub.uni-heidelberg.de/papyri">{{ 'footer.papyrus_collection'|trans }}</a></li>
<li>&nbsp;</li>
                  <li><a target="_blank" href="https://www.ub.uni-heidelberg.de/helios/digi/hd_papyrus.html#GreekList">{{ 'footer.greek_papyri'|trans }}</a></li>
                  <li><a target="_blank" href="https://www.ub.uni-heidelberg.de/helios/digi/hd_papyrus.html#KoptList">{{ 'footer.coptic_papyri'|trans }}</a></li>
                  <li><a target="_blank" href="https://www.ub.uni-heidelberg.de/helios/digi/hd_papyrus.html#LatinList">{{ 'footer.latin_papyri'|trans }}</a></li>
                  <li><a target="_blank" href="https://www.ub.uni-heidelberg.de/helios/digi/hd_papyrus.html#HebList">{{ 'footer.hebrew_papyri'|trans }}</a></li>
                </ul>
            </aside><!-- end of #first footer segment -->

            <aside class="footer-segment">
                <h4>{{ 'footer.awesome_stuff'|trans }}</h4>
                  <ul>
                    <li><a target="_blank" href="https://www.papyri.info/">Papyri.info</a></li>
                    <li><a target="_blank" href="https://www.trismegistos.org/">Trismegistos</a></li>
                    <li><a target="_blank" href="https://bibpap.be/">Bibliographie Papyrologique</a></li>
                  </ul>
            </aside><!-- end of #second footer segment -->

            <aside class="footer-segment">
                <h4>{{ 'footer.institute_direction'|trans }}</h4>
                <ul>
                  <li><a target="_blank" href="mailto:%22Holger%20Essler%22%3cholger.essler@uni-heidelberg.de%3e?subject=HGV">Prof. Dr. Holger Essler</a></li>
                </ul>
                <h4>{{ 'footer.secretariat'|trans }}</h4>
                <ul>
                  <li><a href="mailto:papyrologie@zaw.uni-heidelberg.de?subject=HGV">papyrologie@zaw.uni-heidelberg.de</a></li>
                </ul>
            </aside><!-- end of #third footer segment -->

            <aside class="footer-segment">
                <h4>{{ 'footer.institute'|trans }}</h4>
                  <p>&copy; 2012 <a target="_blank" href="https://www.uni-heidelberg.de/fakultaeten/philosophie/zaw/papy">HGV</a><br />Marstallstr. 6<br />D-69117 Heidelberg<br />Tel.: +049-06221-542396<br />Fax.: +49-06221-543679<br /><a href="https://www.uni-heidelberg.de/datenschutzerklaerung_web.html" target="_zde">{{ 'footer.privacy'|trans }}</a></p>
            </aside><!-- end of #fourth footer segment -->

        </section><!-- end of footer-outer-block -->

      </section><!-- end of footer-area -->
    </footer>
  
    </div><!-- #wrapper -->
        
        {% block javascripts %}
            <script>
              window.HGV_TRANS = {
                dt: {
                  lengthMenu: {{ 'js.dt.lengthMenu'|trans|json_encode|raw }},
                  zeroRecords: {{ 'js.dt.zeroRecords'|trans|json_encode|raw }},
                  info: {{ 'js.dt.info'|trans|json_encode|raw }},
                  infoEmpty: {{ 'js.dt.infoEmpty'|trans|json_encode|raw }},
                  infoFiltered: {{ 'js.dt.infoFiltered'|trans|json_encode|raw }},
                  search: {{ 'js.dt.search'|trans|json_encode|raw }},
                  processing: {{ 'js.dt.processing'|trans|json_encode|raw }},
                  paginate: {
                    first: {{ 'js.dt.first'|trans|json_encode|raw }},
                    last: {{ 'js.dt.last'|trans|json_encode|raw }},
                    next: {{ 'js.dt.next'|trans|json_encode|raw }},
                    previous: {{ 'js.dt.previous'|trans|json_encode|raw }}
                  },
                  buttons: {
                    colvis: {{ 'js.dt.colvis'|trans|json_encode|raw }},
                    copy: {{ 'js.dt.copy'|trans|json_encode|raw }},
                    csv: {{ 'js.dt.csv'|trans|json_encode|raw }},
                    print: {{ 'js.dt.print'|trans|json_encode|raw }}
                  }
                },
                btn: {
                  export_label: {{ 'js.btn.export'|trans|json_encode|raw }},
                  reset: {{ 'js.btn.reset'|trans|json_encode|raw }},
                  tips: {{ 'js.btn.tips'|trans|json_encode|raw }}
                },
                table: {
                  publication: {{ 'table.publication'|trans|json_encode|raw }},
                  dating: {{ 'table.dating'|trans|json_encode|raw }},
                  place: {{ 'table.place'|trans|json_encode|raw }},
                  title: {{ 'table.title'|trans|json_encode|raw }},
                  material: {{ 'table.material'|trans|json_encode|raw }},
                  keywords: {{ 'table.keywords'|trans|json_encode|raw }},
                  other_publications: {{ 'table.other_publications'|trans|json_encode|raw }},
                  tm_no: {{ 'table.tm_no'|trans|json_encode|raw }},
                  ddb: {{ 'table.ddb'|trans|json_encode|raw }},
                  hgv_id: {{ 'table.hgv_id'|trans|json_encode|raw }},
                  publication_abbr: {{ 'table.publication_abbr'|trans|json_encode|raw }},
                  volume: {{ 'table.volume'|trans|json_encode|raw }},
                  number: {{ 'table.number'|trans|json_encode|raw }},
                  not_before: {{ 'table.not_before'|trans|json_encode|raw }},
                  not_after: {{ 'table.not_after'|trans|json_encode|raw }},
                  exact_date: {{ 'table.exact_date'|trans|json_encode|raw }},
                  precision: {{ 'table.precision'|trans|json_encode|raw }},
                  settlement: {{ 'table.settlement'|trans|json_encode|raw }},
                  collection: {{ 'table.collection'|trans|json_encode|raw }},
                  inv_no: {{ 'table.inv_no'|trans|json_encode|raw }},
                  provenance: {{ 'table.provenance'|trans|json_encode|raw }},
                  provenance_place: {{ 'table.provenance_place'|trans|json_encode|raw }},
                  provenance_nome: {{ 'table.provenance_nome'|trans|json_encode|raw }},
                  illustrations: {{ 'table.illustrations'|trans|json_encode|raw }},
                  figure_urls: {{ 'table.figure_urls'|trans|json_encode|raw }},
                  translations: {{ 'table.translations'|trans|json_encode|raw }},
                  commentary: {{ 'table.commentary'|trans|json_encode|raw }},
                  mentioned_dates: {{ 'table.mentioned_dates'|trans|json_encode|raw }},
                  bl_online: {{ 'table.bl_online'|trans|json_encode|raw }}
                },
                filter: {
                  heading: {{ 'filter.heading'|trans|json_encode|raw }},
                  description: {{ 'filter.description'|trans|json_encode|raw }},
                  input: {{ 'filter.input'|trans|json_encode|raw }},
                  meaning: {{ 'filter.meaning'|trans|json_encode|raw }},
                  example: {{ 'filter.example'|trans|json_encode|raw }},
                  contains: {{ 'filter.contains'|trans|json_encode|raw }},
                  all_words: {{ 'filter.all_words'|trans|json_encode|raw }},
                  starts_with: {{ 'filter.starts_with'|trans|json_encode|raw }},
                  ends_with: {{ 'filter.ends_with'|trans|json_encode|raw }},
                  exact_match: {{ 'filter.exact_match'|trans|json_encode|raw }},
                  not_contains: {{ 'filter.not_contains'|trans|json_encode|raw }},
                  numeric: {{ 'filter.numeric'|trans|json_encode|raw }},
                  date_range: {{ 'filter.date_range'|trans|json_encode|raw }},
                  not_empty: {{ 'filter.not_empty'|trans|json_encode|raw }},
                  empty: {{ 'filter.empty'|trans|json_encode|raw }},
                  sorting_heading: {{ 'filter.sorting_heading'|trans|json_encode|raw }},
                  sorting_text: {{ 'filter.sorting_text'|trans|json_encode|raw }},
                  sorting_shift: {{ 'filter.sorting_shift'|trans|json_encode|raw }},
                  columns_heading: {{ 'filter.columns_heading'|trans|json_encode|raw }},
                  columns_text: {{ 'filter.columns_text'|trans|json_encode|raw }},
                  columns_show_hide: {{ 'filter.columns_show_hide'|trans|json_encode|raw }},
                  columns_button: {{ 'filter.columns_button'|trans|json_encode|raw }},
                  columns_toggle: {{ 'filter.columns_toggle'|trans|json_encode|raw }},
                  close: {{ 'filter.close'|trans|json_encode|raw }},
                  placeholder: {{ 'js.filter_placeholder'|trans|json_encode|raw }}
                },
                feedback: {
                  close: {{ 'js.feedback.close'|trans|json_encode|raw }},
                  sending: {{ 'js.feedback.sending'|trans|json_encode|raw }},
                  thanks: {{ 'js.feedback.thanks'|trans|json_encode|raw }},
                  error: {{ 'js.feedback.error'|trans|json_encode|raw }},
                  default_subject: {{ 'js.feedback.default_subject'|trans|json_encode|raw }},
                  default_body: {{ 'js.feedback.default_body'|trans|json_encode|raw }}
                },
                loading: {{ 'js.loading'|trans|json_encode|raw }}
              };
            </script>
            <script src="{{ asset('js/jquery/jquery-3.7.1.min.js') }}"></script>
            <script src="{{ asset('js/jquery/jquery-ui.min.js') }}"></script>
            <script src="{{ asset('js/main.js') }}"></script>
            <script src="{{ asset('js/jquery/feedback.js') }}"></script>
            <script src="{{ asset('js/clipboard/clipboard.min.js') }}"></script>
        {% endblock %}
    </body>
</html>
